{
  "name": "wexample/symfony-live",
  "description": "Server side of Wex live updates: Mercure topics, subscriber tokens and publication",
  "type": "library",
  "license": "MIT",
  "version": "4.0.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyLive\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "lcobucci/jwt": "^4.0 || ^5.0",
    "symfony/mercure": "^0.6",
    "symfony/mercure-bundle": "^0.3",
    "wexample/php-helpers": ">=4.0.0",
    "wexample/symfony-helpers": ">=9.0.0"
  },
  "extra": {
    "install": {
      "bundle_env": "all",
      "files": {
        "src/Resources/install/config/packages/mercure.yaml": "config/packages/mercure.yaml"
      },
      "blocks": {
        "src/Resources/install/caddy/mercure.Caddyfile": ".wex/caddy/Caddyfile"
      }
    }
  }
}