mercure {
    # The *_jwt directives below are only accepted in compatibility mode by newer
    # Mercure modules: without this line the hub refuses to provision there and
    # the whole web server fails to start. 7 is the one version that mode takes —
    # 8 is refused at parse time, and the server never starts either.
    protocol_version_compatibility 7
    publisher_jwt {$MERCURE_JWT_SECRET:!ChangeThisMercureHubJWTSecretKey!}
    subscriber_jwt {$MERCURE_JWT_SECRET:!ChangeThisMercureHubJWTSecretKey!}
    cors_origins {$MERCURE_CORS_ORIGINS:*}
    publish_origins {$MERCURE_PUBLISH_ORIGINS:*}
    anonymous
    subscriptions
}
